# Neat Video ライセンス (動的解析検証専用。検証終了後は deactivate.sh が元に戻す)
# このファイルには個人情報 (ライセンスコード) が入るので git にコミットしない・ログに出さない
#
# 記入例:
#   NV_LICENSE_NAME="Taro Yamada"
#   NV_LICENSE_ORG=""
#   NV_LICENSE_COPIES="1"
#   NV_LICENSE_CODE="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"
#
# ライセンスの種類 (使用するホストに対応するもの):
#   ofx    : DaVinci Resolve / FCP / Vegas など OFX ホスト用
#   pr     : Adobe Premiere Pro 用
#   (今回の動的解析の対象は OFX バイナリなので ofx のライセンスが必要)

NV_LICENSE_NAME=""
NV_LICENSE_ORG=""
NV_LICENSE_COPIES="1"
NV_LICENSE_CODE=""
NV_LICENSE_TYPE="ofx"
