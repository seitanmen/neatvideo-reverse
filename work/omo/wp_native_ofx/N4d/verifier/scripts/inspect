#!/bin/sh
D=/private/tmp/claude-501/-Users-seitan-Desktop-work-reverse/040b381d-b723-4608-b0cb-2e82227f9c2d/scratchpad/verify_n4d/insp
n=$(ls $D | grep -c '^call')
c=$D/call$n
mkdir -p $c
env > $c/env.txt
ls -l /dev/fd/ > $c/myfds.txt 2>&1
/usr/sbin/lsof -p $PPID > $c/parent_lsof.txt 2>&1
ps -o pid,ppid,stat,command -A | awk -v p=$PPID '$2==p' > $c/children.txt
echo "$@" > $c/args.txt
if [ "$1" = "--ofx-default" ]; then printf 'DEFAULTS 0 none none\n'; exit 0; fi
head -c 2000 > $c/head.txt
cat > /dev/null
printf 'CANCEL\n'
