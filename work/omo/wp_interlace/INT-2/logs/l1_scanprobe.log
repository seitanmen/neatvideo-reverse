ffv1_tff.mov	stream=tb	interlaced_frame=1	top_field_first=1	first_field=0	interlaced, top field first (stream field_order: tb)
prores_bff.mov	stream=bt	interlaced_frame=1	top_field_first=0	first_field=1	interlaced, bottom field first (stream field_order: bt)
prores_noild_tff.mov	stream=tb	interlaced_frame=0	top_field_first=0	first_field=-1	interlaced, field order unknown (stream field_order: tb, first frame not flagged interlaced)
