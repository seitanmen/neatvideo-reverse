# N1i: AutoFineTune port (nv_aft) over nv_band (N1a), nv_curve (N1b, IsClip), nv_model (N1e) and
# nv_ndimage (N1g, numpy.interp for the nv_aft_v5 combination) - separate makefile until the lead
# merges it into native/Makefile.
#   make -C native -f Makefile.aft && python3 native/verify_aft.py
# Same flags as native/Makefile: no fast-math, no FMA contraction.

CXX ?= clang++
CXXFLAGS ?= -std=c++17 -O2 -ffp-contract=off -fno-fast-math -Wall -Wextra

all: nv_aft_test

nv_aft_test: nv_aft_main.cpp nv_aft.cpp nv_aft.h nv_band.cpp nv_band.h nv_curve.cpp nv_curve.h nv_model.cpp nv_model.h nv_ndimage.cpp nv_ndimage.h nv_linekernel.cpp nv_linekernel.h nv_portable.cpp nv_portable.h
	$(CXX) $(CXXFLAGS) $(MUTFLAGS) -o $@ nv_aft_main.cpp nv_aft.cpp nv_band.cpp nv_curve.cpp nv_model.cpp nv_ndimage.cpp nv_linekernel.cpp nv_portable.cpp -lpthread

verify: nv_aft_test
	python3 verify_aft.py

clean:
	rm -f nv_aft_test

.PHONY: all verify clean
